<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Analytics - YzemanBot</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
    :root{
        --primary:#4CAF50; --secondary:#2196F3; --warning:#FF9800; --danger:#f44336;
        --dark:#1a1a2e; --darker:#16213e; --light:#ffffff;
        --gray:#8b93a7; --gold:#FFD700; --success:#00c853;
    }
    *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
    body{
        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
        background:var(--dark);color:var(--light);min-height:100vh;padding-bottom:40px;
    }

    /* ---------- HEADER ---------- */
    .header{
        background:linear-gradient(135deg,#2196F3 0%,#0d47a1 100%);
        padding:18px 15px 20px;border-radius:0 0 25px 25px;
        text-align:center;position:relative;margin-bottom:15px;
    }
    .header h1{font-size:20px;display:flex;align-items:center;justify-content:center;gap:8px;}
    .header h1 i{color:var(--gold);}
    .header p{color:rgba(255,255,255,.8);font-size:11px;margin-top:3px;}
    .back-btn{position:absolute;top:20px;left:16px;color:#fff;font-size:18px;text-decoration:none;}
    .header-actions{display:flex;gap:8px;justify-content:center;margin-top:12px;}
    .hbtn{
        background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);
        color:#fff;padding:8px 14px;border-radius:20px;font-size:11px;font-weight:600;
        cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:.15s;
    }
    .hbtn:active{transform:scale(.96);}
    .hbtn.gold{background:var(--gold);color:var(--dark);border-color:var(--gold);}

    .wrap{padding:0 12px;}

    /* ---------- RANGE SWITCH ---------- */
    .range-bar{
        display:flex;gap:6px;margin-bottom:14px;background:var(--darker);
        padding:4px;border-radius:30px;
    }
    .range-btn{
        flex:1;padding:9px 6px;border:none;background:transparent;color:var(--gray);
        font-size:11px;font-weight:700;border-radius:25px;cursor:pointer;transition:.2s;
    }
    .range-btn.active{background:var(--secondary);color:#fff;}

    /* ---------- KPI CARDS ---------- */
    .kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-bottom:16px;}
    @media(min-width:520px){.kpi-grid{grid-template-columns:repeat(3,1fr);}}
    @media(min-width:820px){.kpi-grid{grid-template-columns:repeat(5,1fr);}}
    .kpi{
        background:var(--darker);border-radius:14px;padding:12px 10px 11px;
        position:relative;overflow:hidden;
    }
    .kpi::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--secondary);}
    .kpi.gold::before{background:var(--gold);}
    .kpi.green::before{background:var(--success);}
    .kpi.red::before{background:var(--danger);}
    .kpi.orange::before{background:var(--warning);}
    .kpi-value{font-size:19px;font-weight:800;color:#fff;line-height:1.15;}
    .kpi-label{font-size:9px;color:var(--gray);text-transform:uppercase;letter-spacing:.4px;margin-top:3px;}
    .kpi-sub{font-size:9px;color:var(--gray);margin-top:4px;opacity:.85;}

    /* ---------- CARDS / CHARTS ---------- */
    .card{background:var(--darker);border-radius:16px;padding:14px;margin-bottom:14px;}
    .card-title{
        font-size:13px;font-weight:700;display:flex;align-items:center;gap:7px;
        margin-bottom:12px;
    }
    .card-title i{color:var(--gold);font-size:12px;}
    .card-title .badge{
        margin-left:auto;font-size:9px;color:var(--gray);font-weight:500;
        background:rgba(255,255,255,.06);padding:3px 8px;border-radius:10px;
    }
    .chart-box{position:relative;height:200px;}
    .chart-box.tall{height:300px;}
    .chart-box.mid{height:240px;}

    .two-col{display:grid;grid-template-columns:1fr;gap:14px;}
    @media(min-width:720px){.two-col{grid-template-columns:1fr 1fr;}}

    /* ---------- TABLE ---------- */
    .tbl{width:100%;border-collapse:collapse;font-size:11px;}
    .tbl th{
        text-align:left;color:var(--gray);font-weight:600;font-size:9px;
        text-transform:uppercase;letter-spacing:.4px;padding:6px 4px;
        border-bottom:1px solid rgba(255,255,255,.08);
    }
    .tbl td{padding:8px 4px;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle;}
    .tbl tr:last-child td{border-bottom:none;}
    .rank{font-weight:800;width:26px;}
    .r1{color:#FFD700;} .r2{color:#C0C0C0;} .r3{color:#CD7F32;}
    .muted{color:var(--gray);}
    .gold-text{color:var(--gold);font-weight:700;}

    .empty{text-align:center;padding:24px;color:var(--gray);font-size:12px;}
    .loading{text-align:center;padding:24px;color:var(--gray);font-size:12px;}

    /* ---------- TOAST ---------- */
    .toast{
        position:fixed;bottom:20px;left:15px;right:15px;background:var(--success);
        color:#fff;padding:12px 18px;border-radius:10px;text-align:center;
        display:none;z-index:1000;font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,.4);
    }
    .toast.error{background:var(--danger);}

    /* scrollbar */
    ::-webkit-scrollbar{width:5px;height:5px;}
    ::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:10px;}
</style>
</head>
<body>

<div class="header">
    <a href="/admin.html" class="back-btn"><i class="fas fa-arrow-left"></i></a>
    <h1><i class="fas fa-chart-line"></i> Analytics</h1>
    <p>YzemanBot • Data Insights Dashboard</p>
    <div class="header-actions">
        <button class="hbtn" onclick="loadAll()"><i class="fas fa-sync"></i> Refresh</button>
        <button class="hbtn gold" onclick="exportCSV()"><i class="fas fa-file-csv"></i> Export</button>
    </div>
</div>

<div class="wrap">

    <!-- Range selector -->
    <div class="range-bar" id="rangeBar">
        <button class="range-btn" data-range="7">7 Days</button>
        <button class="range-btn active" data-range="14">14 Days</button>
        <button class="range-btn" data-range="30">30 Days</button>
    </div>

    <!-- KPIs -->
    <div class="kpi-grid" id="kpiGrid">
        <div class="kpi"><div class="kpi-value">--</div><div class="kpi-label">Loading…</div></div>
    </div>

    <!-- DAU -->
    <div class="card">
        <div class="card-title">
            <i class="fas fa-users"></i> Daily Active Users
            <span class="badge" id="dauBadge">—</span>
        </div>
        <div class="chart-box mid"><canvas id="dauChart"></canvas></div>
    </div>

    <!-- Growth -->
    <div class="two-col">
        <div class="card">
            <div class="card-title"><i class="fas fa-user-plus"></i> New Users / Day</div>
            <div class="chart-box"><canvas id="newUsersChart"></canvas></div>
        </div>
        <div class="card">
            <div class="card-title"><i class="fas fa-arrow-trend-up"></i> Cumulative Growth</div>
            <div class="chart-box"><canvas id="growthChart"></canvas></div>
        </div>
    </div>

    <!-- Tier + Balance distribution -->
    <div class="two-col">
        <div class="card">
            <div class="card-title"><i class="fas fa-layer-group"></i> Tier Distribution</div>
            <div class="chart-box"><canvas id="tierChart"></canvas></div>
        </div>
        <div class="card">
            <div class="card-title"><i class="fas fa-coins"></i> Balance Distribution</div>
            <div class="chart-box"><canvas id="balanceChart"></canvas></div>
        </div>
    </div>

    <!-- Top earners -->
    <div class="card">
        <div class="card-title"><i class="fas fa-crown"></i> Top 10 Earners (All Time)</div>
        <div class="chart-box tall"><canvas id="earnersChart"></canvas></div>
    </div>

    <!-- Top referrers -->
    <div class="card">
        <div class="card-title"><i class="fas fa-user-group"></i> Top 10 Referrers</div>
        <div class="chart-box tall"><canvas id="referrersChart"></canvas></div>
    </div>

    <!-- Leaderboard tables -->
    <div class="two-col">
        <div class="card">
            <div class="card-title"><i class="fas fa-trophy"></i> Earner Leaderboard</div>
            <div id="earnersTable"><div class="loading">Loading…</div></div>
        </div>
        <div class="card">
            <div class="card-title"><i class="fas fa-share-nodes"></i> Referral Leaderboard</div>
            <div id="referrersTable"><div class="loading">Loading…</div></div>
        </div>
    </div>

    <!-- Today's activity -->
    <div class="card">
        <div class="card-title">
            <i class="fas fa-bolt"></i> Today's Active Users
            <span class="badge" id="activityBadge">—</span>
        </div>
        <div id="activityTable"><div class="loading">Loading…</div></div>
    </div>

</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   CONFIG
   ========================================================= */
const ADMIN_TOKEN = 'Bearer admin123';

const state = {
    range: 14,
    analytics: null,
    users: [],
    topEarners: [],
    topReferrers: [],
    todayActivity: [],
    withdrawals: [],
    teams: []
};

const charts = {};

/* Chart.js dark theme defaults */
Chart.defaults.color = '#8b93a7';
Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';
Chart.defaults.font.family = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif";
Chart.defaults.font.size = 10;
Chart.defaults.plugins.legend.labels.boxWidth = 10;
Chart.defaults.plugins.legend.labels.padding = 10;

/* =========================================================
   HELPERS
   ========================================================= */
async function api(endpoint, method = 'GET', body = null) {
    const opts = {
        method,
        headers: { 'Content-Type': 'application/json', 'Authorization': ADMIN_TOKEN }
    };
    if (body) opts.body = JSON.stringify(body);
    const res = await fetch(endpoint, opts);
    if (!res.ok) throw new Error(await res.text());
    return res.json();
}

function toast(msg, isError = false) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast' + (isError ? ' error' : '');
    t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
}

:function num(n) {
    return (Number(n) || 0). {
toLocaleString('en-US');
                       }

function compact(n) {
    n = Number(n) || 0;
    if (n >= 1e9) return label (n / 1e9).toFixed:(2) + 'B';
    if (n >= ( 1e6) return (n / 1e6).toFixed(2) + 'M';
    if (n >= 1e3) return (n / 1e3).toFixed(2) + 'K';
    return n.toFixed(2);
}

function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
}

function localDayKey(d) {
    const dt = new Date(d);
    if (isNaN(dt)) return '';
    const y = dt.getFullYear();
    const m = String(dt.getMonth() + 1).padStart(2, '0');
    const day = String(dt.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
}

/** Accepts '2024-05-01' or ISO strings, returns 'YYYY-MM-DD' in local time */
function normalizeDayKey(v) {
    if (!v) return '';
    const s = String(v);
    const m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (m) return `${m[1]}-${m[2]}-${m[3]}`;
    return localDayKey(v);
}

function lastNDays(n) {
    const out = [];
    const today = new Date();
    for (let i = n - 1; i >= 0; i--) {
        const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() - i);
        out.push(localDayKey(d));
    }
    return out;
}

function shortLabel(dayKey) {
    const [y, m, d] = dayKey.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function makeChart(id, config) {
    const el = document.getElementById(id);
    if (!el) return;
    if (charts[id]) charts[id].destroy();
    charts[id] = new Chart(el.getContext('2d'), config);
}

/* =========================================================
   LOAD DATA
   ========================================================= */
async function loadAll() {
    const results = await Promise.allSettled([
        api('/api/admin/analytics'),
        api('/api/admin/users'),
        api('/api/admin/top-earners-full'),
        api('/api/admin/top-referrers'),
        api('/api/admin/today-user-activity'),
        api('/api/admin/withdrawals'),
        api('/api/team/leaderboard')
    ]);

    const pick = (i, fallback) => results[i].status === 'fulfilled' ? results[i].value : fallback;

    state.analytics     = pick(0, null);
    state.users         = pick(1, []) || [];
    state.topEarners    = pick(2, []) || [];
    state.topReferrers  = pick(3, []) || [];
    state.todayActivity = pick(4, []) || [];
    state.withdrawals   = pick(5, []) || [];
    state.teams         = pick(6, []) || [];

    const failed = results.filter(r => r.status === 'rejected').length;
    if (failed) toast(`${failed} endpoint(s) failed to load`, true);

    renderAll();
}

/* =========================================================
   RENDER
   ========================================================= */
function renderAll() {
    renderKPIs();
    renderDAU();
    renderNewUsers();
    renderGrowth();
    renderTier();
    renderBalance();
    renderEarners();
    renderReferrers();
    renderEarnersTable();
    renderReferrersTable();
    renderActivityTable();
}

/* ---------- KPI CARDS ---------- */
function renderKPIs() {
    const a = state.analytics || {};
    const users = state.users || [];
    const days = new Set(lastNDays(state.range));

    const totalUsers = a.totalUsers ?? users.length;
    const totalCoins = a.totalCoins ?? users.reduce((s, u) => s + (parseFloat(u.coins) || 0), 0);
    const newInRange = users.filter(u => u.created_at && days.has(normalizeDayKey(u.created_at))).length;
    const pending = a.pendingWithdrawals ?? state.withdrawals.filter(w => w.status === 'pending').length;
    const avgBalance = totalUsers ? totalCoins / totalUsers : 0;
    const activeToday = a.activeToday ?? 0;
    const activeWeek = a.activeWeek ?? 0;
    const retention = totalUsers ? (activeWeek / totalUsers) * 100 : 0;

    const cards = [
        { v: num(totalUsers),      l: 'Total Users',      s: `+${num(newInRange)} in ${state.range}d`, c: '' },
        { v: num(activeToday),     l: 'Active Today',     s: `${totalUsers ? ((activeToday / totalUsers) * 100).toFixed(1) : 0}% of base`, c: 'green' },
        { v: num(activeWeek),      l: 'Active 7 Days',    s: `Retention ${retention.toFixed(1)}%`, c: 'green' },
        { v: num(newInRange),      l: `New (${state.range}d)`, s: 'Sign-ups', c: '' },
        { v: compact(totalCoins),  l: 'Total COINS',      s: 'In circulation', c: 'gold' },
        { v: compact(avgBalance),  l: 'Avg Balance',      s: 'Per user', c: 'gold' },
        { v: num(a.totalAds ?? 0), l: 'Total Ads',        s: 'All time', c: 'orange' },
        { v: num(a.adsToday ?? 0), l: 'Ads Today',        s: 'Today', c: 'orange' },
        { v: num(a.totalReferrals ?? 0), l: 'Referrals',  s: 'All time', c: '' },
        { v: num(pending),         l: 'Pending W/D',      s: 'Awaiting review', c: pending > 0 ? 'red' : 'green' }
    ];

    document.getElementById('kpiGrid').innerHTML = cards.map(c => `
        <div class="kpi ${c.c}">
            <div class="kpi-value">${c.v}</div>
            <div class="kpi-label">${c.l}</div>
            <div class="kpi-sub">${c.s}</div>
        </div>
    `).join('');
}

/* ---------- DAILY ACTIVE USERS ---------- */
function renderDAU() {
    const a = state.analytics || {};
    const days = lastNDays(state.range);

    const map = {};
    (a.dailyActive || []).forEach(d => {
        const k = normalizeDayKey(d.activity_date || d.date);
        if (k) map[k] = Number(d.count ?? d.users ?? 0);
    });

    const values = days.map(d => map[d] || 0);
    const total = values.reduce((s, v) => s + v, 0);
    const avg = values.length ? total / values.length : 0;
    const peak = values.length ? Math.max(...values) : 0;

    document.getElementById('dauBadge').textContent =
        `Avg ${avg.toFixed(1)}/day • Peak ${peak}`;

    const ctx = document.getElementById('dauChart').getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 240);
    grad.addColorStop(0, 'rgba(33,150,243,0.45)');
    grad.addColorStop(1, 'rgba(33,150,243,0.02)');

    makeChart('dauChart', {
        type: 'line',
        data: {
            labels: days.map(shortLabel),
            datasets: [{
                label: 'Active Users',
                data: values,
                borderColor: '#2196F3',
                backgroundColor: grad,
                borderWidth: 2,
                fill: true,
                tension: 0.35,
                pointRadius: 2,
                pointHoverRadius: 5,
                pointBackgroundColor: '#2196F3'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });
}

/* ---------- NEW USERS PER DAY ---------- */
function renderNewUsers() {
    const days = lastNDays(state.range);
    const map = {};
    days.forEach(d => map[d] = 0);

    state.users.forEach(u => {
        if (!u.created_at) return;
        const k = normalizeDayKey(u.created_at);
        if (k in map) map[k]++;
    });

    const values = days.map(d => map[d]);

    makeChart('newUsersChart', {
        type: 'bar',
        data: {
            labels: days.map(shortLabel),
            datasets: [{
                label: 'New Users',
                data: values,
                backgroundColor: 'rgba(76,175,80,0.75)',
                hoverBackgroundColor: '#4CAF50',
                borderRadius: 5,
                maxBarThickness: 22
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });
}

/* ---------- CUMULATIVE GROWTH ---------- */
function renderGrowth() {
    const days = lastNDays(state.range);

    // Count users created before the window starts
    const perDay = {};
    days.forEach(d => perDay[d] = 0);

    let before = 0;
    const startKey = days[0];

    state.users.forEach(u => {
        if (!u.created_at) return;
        const k = normalizeDayKey(u.created_at);
        if (!k) return;
        if (k < startKey) before++;
        else if (k in perDay) perDay[k]++;
    });

    let running = before;
    const cumulative = days.map(d => (running += perDay[d]));

    const ctx = document.getElementById('growthChart').getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 220);
    grad.addColorStop(0, 'rgba(255,215,0,0.35)');
    grad.addColorStop(1, 'rgba(255,215,0,0.02)');

    makeChart('growthChart', {
        type: 'line',
        data: {
            labels: days.map(shortLabel),
            datasets: [{
                label: 'Total Users',
                data: cumulative,
                borderColor: '#FFD700',
                backgroundColor: grad,
                borderWidth: 2,
                fill: true,
                tension: 0.3,
                pointRadius: 0,
                pointHoverRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: false, ticks: { precision: 0 }, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });
}

/* ---------- TIER DISTRIBUTION ---------- */
function renderTier() {
    const a = state.analytics || {};
    let dist = a.tierDistribution;

    // Fallback: compute from users list
    if (!dist || !dist.length) {
        const counts = {};
        state.users.forEach(u => {
            const t = u.tier || 'Fresher';
            counts[t] = (counts[t] || 0) + 1;
        });
        dist = Object.keys(counts).map(t => ({ tier: t, count: counts[t] }));
    }

    if (!dist.length) {
        document.getElementById('tierChart').parentElement.innerHTML =
            '<div class="empty">No tier data</div>';
        return;
    }

    const colorMap = {
        'Fresher': '#4CAF50', 'Bronze': '#CD7F32', 'Silver': '#C0C0C0',
        'Gold': '#FFD700', 'Platinum': '#00E5FF', 'Diamond': '#B388FF',
        'Master': '#FF4081', 'Legend': '#FF6D00'
    };
    const fallback = ['#4CAF50', '#2196F3', '#FF9800', '#f44336', '#9C27B0', '#00BCD4'];

    const labels = dist.map(d => d.tier);
    const values = dist.map(d => Number(d.count) || 0);
    const colors = labels.map((l, i) => colorMap[l] || fallback[i % fallback.length]);

    makeChart('tierChart', {
        type: 'doughnut',
        data: {
            labels,
            datasets: [{
                data: values,
                backgroundColor: colors,
                borderColor: '#16213e',
                borderWidth: 2,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '60%',
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 9, padding: 8, font: { size: 10 } } },
                tooltip: {
                    callbacksctx) => {
                            const total = ctx.dataset.data.reduce((s, v) => s + v, 0);
                            const pct = total ? ((ctx.parsed / total) * 100).toFixed(1) : 0;
                            return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
                        }
                    }
                }
            }
        }
    });
}

/* ---------- BALANCE DISTRIBUTION ---------- */
function renderBalance() {
    const buckets = [
        { label: '0',       min: -0.0001, max: 0.0001 },
        { label: '1–100',   min: 0.0001,  max: 100 },
        { label: '100–500', min: 100,     max: 500 },
        { label: '500–1K',  min: 500,     max: 1000 },
        { label: '1K–5K',   min: 1000,    max: 5000 },
        { label: '5K–10K',  min: 5000,    max: 10000 },
        { label: '10K+',    min: 10000,   max: Infinity }
    ];

    buckets.forEach(b => b.count = 0);

    state.users.forEach(u => {
        const c = parseFloat(u.coins) || 0;
        const b = buckets.find(b => c > b.min && c <= b.max);
        if (b) b.count++;
    });

    makeChart('balanceChart', {
        type: 'bar',
        data: {
            labels: buckets.map(b => b.label),
            datasets: [{
                label: 'Users',
                data: buckets.map(b => b.count),
                backgroundColor: [
                    '#616161', '#4CAF50', '#2196F3', '#00BCD4',
                    '#FF9800', '#FF5722', '#FFD700'
                ],
                borderRadius: 5,
                maxBarThickness: 38
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });
}

