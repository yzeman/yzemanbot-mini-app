document.getElementById('rangeBar').addEventListener('click', (e) => {
    const btn = e.target.closest('.range-btn');
    if (!btn) return;
    document.querySelectorAll('.range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    state.range = parseInt(btn.dataset.range, 10);
    renderKPIs();
    renderDAU();
    renderNewUsers();
    renderGrowth();
});

/* =========================================================
   EXPORT CSV
   ========================================================= */
function exportCSV() {
    const a = state.analytics || {};
    const rows = [
        ['YzemanBot Analytics Export'],
        ['Generated', new Date().toISOString()],
        ['Range', `${state.range} days`],
        [],
        ['Metric', 'Value'],
        ['Total Users', a.totalUsers ?? state.users.length],
        ['Active Today', a.activeToday ?? 0],
        ['Active 7 Days', a.activeWeek ?? 0],
        ['Total COINS', a.totalCoins ?? 0],
        ['Total Ads', a.totalAds ?? 0],
        ['Ads Today', a.adsToday ?? 0],
        ['Total Referrals', a.totalReferrals ?? 0],
        ['Pending Withdrawals', state.withdrawals.filter(w => w.status === 'pending').length],
        ['Total Teams', state.teams.length],
        [],
        ['Rank', 'Top Earners', 'COINS'],
        ...(state.topEarners || []).slice(0, 20).map((u, i) =>
            [i + 1, u.first_name || u.username || 'User', u.total_coins ?? u.coins ?? 0]),
        [],
        ['Rank', 'Top Referrers', 'Referrals'],
        ...(state.topReferrers || []).slice(0, 20).map((u, i) =>
            [i + 1, u.first_name || u.username || 'User', u.referrals ?? 0])
    ];

    const csv = rows.map(r =>
        r.map(cell => `"${String(cell ?? '').replace(/"/g, '""')}"`).join(',')
    ).join('\n');

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `yzeman-analytics-${localDayKey(new Date())}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    toast('✅ Analytics exported');
}

